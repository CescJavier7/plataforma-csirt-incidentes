# Configuración de entorno - Plataforma CSIRT / SOC
NODE_ENV=production
PORT=3000
HOST=127.0.0.1
PERSISTENCE=prisma

# Cadena de conexión MySQL para ejecución fuera de Docker.
# Configure su propia URL y codifique los caracteres especiales de la contraseña.
#
# MySQL administrado (Aiven) con TLS verificado. Prisma NO reconoce el parámetro
# "?ssl-mode=REQUIRED" que entrega Aiven (se conecta SIN cifrar); reemplácelo por:
#   mysql://USUARIO:CONTRASENA@HOST:PUERTO/defaultdb?sslcert=/etc/secrets/aiven-ca.pem&sslaccept=strict
# - sslcert: ruta absoluta al certificado CA del proyecto Aiven (en Render: Secret File).
# - sslaccept=strict: cifra y verifica certificado + hostname (evita MITM).
# - En macOS (solo desarrollo) usar sslaccept=accept_invalid_certs: el certificado de
#   Aiven no incluye EKU serverAuth y el sistema de Apple lo rechaza; Linux sí lo acepta.
DATABASE_URL=

# Secreto JWT HS256 de al menos 32 bytes; genere con: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=30m

# Orígenes autorizados del cliente (separados por coma)
CLIENT_ORIGIN=https://incidentes.suempresa.com

# Contraseñas de siembra iniciales; configure valores únicos
ADMIN_PASSWORD=
SUPERVISOR_PASSWORD=
ANALISTA_PASSWORD=

# Credenciales MySQL para Docker Compose; genere valores únicos
# Para MYSQL_PASSWORD use solo caracteres hexadecimales para que DATABASE_URL sea válida.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=csirt_incidentes
MYSQL_USER=csirt_user
MYSQL_PASSWORD=
