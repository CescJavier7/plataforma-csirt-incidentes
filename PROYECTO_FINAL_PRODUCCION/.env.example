# ==============================================================================
# CONFIGURACIÓN DE ENTORNO - PLATAFORMA DE INCIDENTES CSIRT / SOC
# ==============================================================================

# Entorno de ejecución (development | production | test)
NODE_ENV=production

# Puerto HTTP del backend Node.js
PORT=3000

# Motor de persistencia (prisma = MySQL 8.4 | memory = Mock en memoria para pruebas rápidas)
PERSISTENCE=prisma

# Cadena de conexión JDBC/MySQL para Prisma ORM
DATABASE_URL="mysql://csirt_user:csirt_secure_pass_2026@localhost:3306/csirt_incidentes?sslmode=prefer"

# Clave secreta criptográfica para la firma de tokens JWT (HS256)
# IMPORTANTE EN PRODUCCIÓN: Generar con openssl rand -base64 48
JWT_SECRET="reemplazar_con_clave_criptografica_altamente_segura_csirt_2026"

# Tiempo de vida del token JWT (ej. 15m, 1h, 8h, 1d)
JWT_EXPIRES_IN="8h"

# Orígenes autorizados por la política CORS (separados por coma)
CLIENT_ORIGIN="http://localhost,http://localhost:80,http://localhost:3000,http://127.0.0.1:3000"

# Credenciales de siembra inicial (Seed) para el aprovisionamiento de roles
ADMIN_PASSWORD="Admin_Seguro_2026!#"
SUPERVISOR_PASSWORD="Supervisor_Seguro_2026!#"
ANALISTA_PASSWORD="Analista_Seguro_2026!#"

# Configuración del contenedor MySQL (usado por docker-compose)
MYSQL_ROOT_PASSWORD="root_super_secure_pass_2026"
MYSQL_DATABASE="csirt_incidentes"
MYSQL_USER="csirt_user"
MYSQL_PASSWORD="csirt_secure_pass_2026"

