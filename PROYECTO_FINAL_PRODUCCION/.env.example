# Configuración de entorno - Plataforma CSIRT / SOC
NODE_ENV=production
PORT=3000
HOST=127.0.0.1
PERSISTENCE=prisma

# Cadena de conexión MySQL para ejecución fuera de Docker.
# Configure su propia URL y codifique los caracteres especiales de la contraseña.
DATABASE_URL=

# Secreto JWT HS256 de al menos 32 bytes; genere con: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=30m

# Orígenes autorizados del cliente (separados por coma)
CLIENT_ORIGIN=https://incidentes.suempresa.com

# Contraseñas de siembra iniciales; configure valores únicos
ADMIN_PASSWORD=
SUPERVISOR_PASSWORD=
ANALISTA_PASSWORD=

# Credenciales MySQL para Docker Compose; genere valores únicos
# Para MYSQL_PASSWORD use solo caracteres hexadecimales para que DATABASE_URL sea válida.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=csirt_incidentes
MYSQL_USER=csirt_user
MYSQL_PASSWORD=
