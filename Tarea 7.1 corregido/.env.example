NODE_ENV=production
HOST=127.0.0.1
PORT=3000
# Set to the exact number of trusted reverse proxies; keep 0 when local-only.
TRUST_PROXY_HOPS=0

# Configure unique credentials from a secret manager; minimum 12 characters per password.
INCIDENTE_ANALISTA_USERNAME=
INCIDENTE_ANALISTA_PASSWORD=
INCIDENTE_SUPERVISOR_USERNAME=
INCIDENTE_SUPERVISOR_PASSWORD=
INCIDENTE_ADMIN_USERNAME=
INCIDENTE_ADMIN_PASSWORD=
