# Configuración del servidor
PORT=3000
NODE_ENV=development

# Credenciales de MySQL para Docker Compose. Sustituye los valores de ejemplo.
MYSQL_ROOT_PASSWORD=cambia-esta-clave-root
MYSQL_USER=app_user
MYSQL_PASSWORD=cambia-esta-clave-de-aplicacion
MYSQL_PORT=3306

# Cadena de conexión para Prisma ORM con MySQL
DATABASE_URL="mysql://app_user:cambia-esta-clave-de-aplicacion@localhost:3306/incidentes_db"

# --- Seguridad (Tarea 6) ---
# Genera uno propio: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=reemplaza-por-un-secreto-aleatorio-de-al-menos-32-caracteres
JWT_EXPIRES_IN=1h
# Origen(es) del cliente web permitidos por CORS (separados por coma)
CLIENT_ORIGIN=http://localhost:5500,http://127.0.0.1:5500
# prisma = MySQL (requiere docker compose up -d) | memory = demo sin base de datos
PERSISTENCE=prisma

# Credenciales de usuarios de prueba (opcionales, tienen valores por defecto seguros)
ADMIN_PASSWORD=Admin123!
SUPERVISOR_PASSWORD=Supervisor123!
ANALISTA_PASSWORD=Analista123!
