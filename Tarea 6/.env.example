# Configuración del servidor
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# Credenciales de MySQL para Docker Compose
MYSQL_ROOT_PASSWORD=
MYSQL_USER=app_user
MYSQL_PASSWORD=
MYSQL_PORT=3306

# Cadena de conexión para Prisma ORM con MySQL
DATABASE_URL=

# Seguridad (Tarea 6)
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=30m
# Origen(es) del cliente web permitidos por CORS (separados por coma)
CLIENT_ORIGIN=http://localhost:5500,http://127.0.0.1:5500
# prisma = MySQL (requiere docker compose up -d) | memory = demo sin base de datos
PERSISTENCE=prisma

# Credenciales iniciales únicas; mínimo 12 caracteres cada una
ADMIN_PASSWORD=
SUPERVISOR_PASSWORD=
ANALISTA_PASSWORD=
